{
    "require": {
        "php": ">=8.5",
        "bcosca/fatfree-core": "^3.8.0",
        "twbs/bootstrap": "^5.0",
        "components/jquery": "^3.2",
        "xfra35/f3-access": "^1.0",
        "formr/formr": "^1.4.0",
        "xfra35/f3-cron": "^1.2"
    },
    "require-dev": {
        "rector/rector": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.1"
    },
    "scripts": {
        "post-install-cmd": [
            "cp -rf vendor/twbs/bootstrap/dist/css/bootstrap.min.css web/assets/css/",
            "cp -rf vendor/twbs/bootstrap/dist/js/bootstrap.bundle.min.js web/assets/js/",
            "cp -rf vendor/components/jquery/jquery.min.js web/assets/js/"
        ],
	"post-update-cmd": [
            "cp -rf vendor/twbs/bootstrap/dist/css/bootstrap.min.css web/assets/css/",
            "cp -rf vendor/twbs/bootstrap/dist/js/bootstrap.bundle.min.js web/assets/js/",
            "cp -rf vendor/components/jquery/jquery.min.js web/assets/js/"
        ]
    }
}
